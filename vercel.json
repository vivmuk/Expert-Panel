{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "flask",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "excludeFiles": "{tests/**,.venv/**,web/node_modules/**,**/__pycache__/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
