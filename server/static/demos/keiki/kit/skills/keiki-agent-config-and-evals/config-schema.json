{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentConfig",
  "type": "object",
  "required": ["version", "changelog", "model", "channels", "capabilities", "gateway", "credentials_ref"],
  "properties": {
    "version": { "type": "string" },
    "changelog": { "type": "string" },
    "model": { "type": "string" },
    "channels": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "capabilities": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "gateway": { "type": "object", "required": ["env"], "properties": { "env": { "type": "string", "enum": ["dev", "staging", "prod"] } } },
    "credentials_ref": { "type": "string" }
  },
  "additionalProperties": false
}
