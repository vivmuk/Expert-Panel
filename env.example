# Required — get yours at https://venice.ai (rotate any key that was ever committed!)
VENICE_API_KEY=

# Where the SQLite engagement database lives.
# Local dev: ./data (default). Railway: attach a volume at /data and set this to /data.
DATA_DIR=./data

# SUPERMEMORY_API_KEY=
# Pages print the host from the request. Set PUBLIC_BASE_URL only for links
# generated outside a request. Railway: https://ai-partner.up.railway.app
# Vercel: https://ai-partner-hq.vercel.app
# Those two origins are always allowed. AI_PARTNER_ORIGINS adds more.
# PUBLIC_BASE_URL=https://ai-partner.up.railway.app
# AI_PARTNER_ORIGINS=
# AI_PARTNER_API_KEYS=
# AI_PARTNER_SIGNING_SECRET=
# AI_PARTNER_SIGNING_SECRETS=v1:secret,v2:next-secret
# VERCEL=1

# Optional tuning
# DEFAULT_PANEL_SIZE=20
# MAX_PANEL_SIZE=100
# PANEL_CONCURRENCY=8
# COST_CIRCUIT_BREAKER_MULTIPLIER=3.0
