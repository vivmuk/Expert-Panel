# Required — get yours at https://venice.ai (rotate any key that was ever committed!)
VENICE_API_KEY=

# Where the SQLite engagement database lives.
# Local dev: ./data (default). Railway: attach a volume at /data and set this to /data.
DATA_DIR=./data

# Optional. Stores and recalls one client's context per chat. Off when empty.
# SUPERMEMORY_API_KEY=

# Optional. Printed on the last chat message so a curl user sees absolute links.
# PUBLIC_BASE_URL=https://your-app.vercel.app

# Set when you want this process to behave like the Vercel demo and skip SQLite.
# VERCEL=1

# Optional tuning
# DEFAULT_PANEL_SIZE=20
# MAX_PANEL_SIZE=100
# PANEL_CONCURRENCY=8
# COST_CIRCUIT_BREAKER_MULTIPLIER=3.0
